{
  "name": "chofex-cli",
  "version": "0.1.0",
  "description": "Command-line client for the Chofex Hackathon",
  "type": "module",
  "bin": {
    "chofex": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crafter-station/chofex-hackathon.git",
    "directory": "apps/cli"
  },
  "homepage": "https://github.com/crafter-station/chofex-hackathon#readme",
  "bugs": {
    "url": "https://github.com/crafter-station/chofex-hackathon/issues"
  },
  "license": "MIT",
  "keywords": [
    "chofex",
    "hackathon",
    "cli"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "rm -rf dist && bun build src/index.ts --target=node --outfile=dist/index.js",
    "dev": "bun src/index.ts",
    "lint": "biome lint --error-on-warnings .",
    "format": "biome format --write .",
    "check-types": "tsc --noEmit",
    "test": "bun test",
    "prepack": "bun run build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@effect/platform-node": "4.0.0-rc.112",
    "@chofex/registration-contract": "*",
    "@chofex/typescript-config": "*",
    "@types/bun": "^1.3.14",
    "@types/node": "26.4.1",
    "@vercel/blob": "^2.8.0",
    "effect": "4.0.0-rc.112",
    "typescript": "7.0.2"
  }
}
